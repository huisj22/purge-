{
  "schema": "purgeplus.pack/1",
  "id": "example-template",
  "name": "示例模板（默认不匹配任何文件，可安全预演）",
  "version": "0.0.1",
  "author": "purgeplus",
  "license": "MIT",
  "source": "examples/pack-template.json",
  "target": {
    "adapter": "dsh",
    "versions": ["0.2.x"]
  },
  "risk": {
    "level": "low",
    "reasons": ["模板：仅为演示 schema，规则指向可缺省路径"]
  },
  "rules": [
    {
      "id": "demo-code",
      "layer": "code",
      "path": "lib/example-target.js",
      "optional": true,
      "description": "把下面这条替换成真实目标与真实锚点；path 必须相对宿主基目录（通常是 resources/app）",
      "markers": ["[purge-plus]"],
      "replacements": [
        {
          "pattern": "REPLACE_ME_PATTERN",
          "replace": "REPLACE_ME_TEXT // [purge-plus]",
          "expect": 1
        }
      ]
    }
  ]
}
